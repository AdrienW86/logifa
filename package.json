{
  "name": "logifa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:editor": "tsc -p tsconfig.editor.json",
    "typecheck:billing": "tsc -p tsconfig.lot3a.json",
    "lint": "eslint app components lib utils proxy.ts",
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "test:billing": "node --experimental-strip-types --test tests/billing/*.test.mjs",
    "test:workspace": "node --experimental-strip-types --test tests/workspace/*.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth/*.test.mjs",
    "test:email": "node --experimental-strip-types --test tests/email/*.test.mjs",
    "test:agent": "node --experimental-strip-types --test tests/agent/*.test.mjs",
    "test:postgres": "node --test tests/postgres/recipe.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.14",
    "@supabase/supabase-js": "2.117.3",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
